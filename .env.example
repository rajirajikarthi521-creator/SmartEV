# Smart EV - Environment Variables Configuration

# Firebase Web Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=smartevstation-23664.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartevstation-23664
VITE_FIREBASE_STORAGE_BUCKET=smartevstation-23664.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Routing Service (OSRM compatible road route calculation endpoint)
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Map Tile Configuration
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
